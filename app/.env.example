# ── Auctum Ledger — environment ───────────────────────────────
# Copy to .env. Variable names are contractual — do not rename.

# ── Backend ───────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Email (optional — without these, the Ledger honestly records sends as queued) ──
SMTP_HOST=                # e.g. smtp.gmail.com
SMTP_PORT=587             # 587 STARTTLS / 465 SSL
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false         # true for port 465
SMTP_FROM=                # defaults to SMTP_USER
